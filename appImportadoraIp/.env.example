# Ejemplo de variables de entorno (copiar a .env.local y ajustar). Las variables de Vite deben empezar con VITE_.

# URL del backend REST (si no se define, usa el de Railway)
VITE_API_BASE_URL=https://importadora-back-production.up.railway.app

# URL del websocket de tiempo real. Vacío = tiempo real desactivado.
# Ejemplo: wss://tu-servidor/ws   (cuando se conozca el contrato de eventos, ver features/realtime)
VITE_WS_URL=
